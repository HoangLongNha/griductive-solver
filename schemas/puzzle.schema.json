{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/griductive/puzzle.schema.json",
  "title": "Griductive Puzzle v1",
  "type": "object",
  "required": [
    "schema_version",
    "id",
    "size",
    "initial_revealed",
    "cards"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*$"
    },
    "size": {
      "type": "integer",
      "minimum": 3,
      "maximum": 5
    },
    "initial_revealed": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[A-Z][1-9][0-9]*$"
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "cards": {
      "type": "array",
      "minItems": 9,
      "items": {
        "type": "object",
        "required": [
          "cell",
          "name",
          "profession",
          "hidden_status",
          "clue"
        ],
        "properties": {
          "cell": {
            "type": "string",
            "pattern": "^[A-Z][1-9][0-9]*$"
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "profession": {
            "type": "string",
            "minLength": 1
          },
          "hidden_status": {
            "enum": [
              "CRIMINAL",
              "INNOCENT"
            ]
          },
          "clue": {
            "oneOf": [
              {
                "type": "object",
                "required": [
                  "id",
                  "kind",
                  "cell",
                  "status"
                ],
                "properties": {
                  "id": {
                    "type": "string",
                    "minLength": 1
                  },
                  "kind": {
                    "const": "FACT"
                  },
                  "cell": {
                    "type": "string",
                    "pattern": "^[A-Z][1-9][0-9]*$"
                  },
                  "status": {
                    "enum": [
                      "CRIMINAL",
                      "INNOCENT"
                    ]
                  }
                },
                "additionalProperties": false
              },
              {
                "type": "object",
                "required": [
                  "id",
                  "kind",
                  "cells"
                ],
                "properties": {
                  "id": {
                    "type": "string",
                    "minLength": 1
                  },
                  "kind": {
                    "const": "SAME"
                  },
                  "cells": {
                    "type": "array",
                    "prefixItems": [
                      {
                        "type": "string",
                        "pattern": "^[A-Z][1-9][0-9]*$"
                      },
                      {
                        "type": "string",
                        "pattern": "^[A-Z][1-9][0-9]*$"
                      }
                    ],
                    "minItems": 2,
                    "maxItems": 2,
                    "uniqueItems": true,
                    "items": false
                  }
                },
                "additionalProperties": false
              },
              {
                "type": "object",
                "required": [
                  "id",
                  "kind",
                  "cells"
                ],
                "properties": {
                  "id": {
                    "type": "string",
                    "minLength": 1
                  },
                  "kind": {
                    "const": "DIFFERENT"
                  },
                  "cells": {
                    "type": "array",
                    "prefixItems": [
                      {
                        "type": "string",
                        "pattern": "^[A-Z][1-9][0-9]*$"
                      },
                      {
                        "type": "string",
                        "pattern": "^[A-Z][1-9][0-9]*$"
                      }
                    ],
                    "minItems": 2,
                    "maxItems": 2,
                    "uniqueItems": true,
                    "items": false
                  }
                },
                "additionalProperties": false
              },
              {
                "type": "object",
                "required": [
                  "id",
                  "kind",
                  "k",
                  "region"
                ],
                "properties": {
                  "id": {
                    "type": "string",
                    "minLength": 1
                  },
                  "kind": {
                    "const": "EXACTLY"
                  },
                  "k": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "region": {
                    "oneOf": [
                      {
                        "type": "object",
                        "required": [
                          "type",
                          "index"
                        ],
                        "properties": {
                          "type": {
                            "const": "row"
                          },
                          "index": {
                            "type": "integer",
                            "minimum": 1
                          }
                        },
                        "additionalProperties": false
                      },
                      {
                        "type": "object",
                        "required": [
                          "type",
                          "index"
                        ],
                        "properties": {
                          "type": {
                            "const": "column"
                          },
                          "index": {
                            "type": "string",
                            "pattern": "^[A-Z]$"
                          }
                        },
                        "additionalProperties": false
                      },
                      {
                        "type": "object",
                        "required": [
                          "type",
                          "cell"
                        ],
                        "properties": {
                          "type": {
                            "const": "neighbors"
                          },
                          "cell": {
                            "type": "string",
                            "pattern": "^[A-Z][1-9][0-9]*$"
                          }
                        },
                        "additionalProperties": false
                      },
                      {
                        "type": "object",
                        "required": [
                          "type",
                          "cells"
                        ],
                        "properties": {
                          "type": {
                            "const": "cells"
                          },
                          "cells": {
                            "type": "array",
                            "items": {
                              "type": "string",
                              "pattern": "^[A-Z][1-9][0-9]*$"
                            },
                            "uniqueItems": true,
                            "minItems": 1
                          }
                        },
                        "additionalProperties": false
                      }
                    ]
                  }
                },
                "additionalProperties": false
              },
              {
                "type": "object",
                "required": [
                  "id",
                  "kind",
                  "k",
                  "region"
                ],
                "properties": {
                  "id": {
                    "type": "string",
                    "minLength": 1
                  },
                  "kind": {
                    "const": "AT_LEAST"
                  },
                  "k": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "region": {
                    "oneOf": [
                      {
                        "type": "object",
                        "required": [
                          "type",
                          "index"
                        ],
                        "properties": {
                          "type": {
                            "const": "row"
                          },
                          "index": {
                            "type": "integer",
                            "minimum": 1
                          }
                        },
                        "additionalProperties": false
                      },
                      {
                        "type": "object",
                        "required": [
                          "type",
                          "index"
                        ],
                        "properties": {
                          "type": {
                            "const": "column"
                          },
                          "index": {
                            "type": "string",
                            "pattern": "^[A-Z]$"
                          }
                        },
                        "additionalProperties": false
                      },
                      {
                        "type": "object",
                        "required": [
                          "type",
                          "cell"
                        ],
                        "properties": {
                          "type": {
                            "const": "neighbors"
                          },
                          "cell": {
                            "type": "string",
                            "pattern": "^[A-Z][1-9][0-9]*$"
                          }
                        },
                        "additionalProperties": false
                      },
                      {
                        "type": "object",
                        "required": [
                          "type",
                          "cells"
                        ],
                        "properties": {
                          "type": {
                            "const": "cells"
                          },
                          "cells": {
                            "type": "array",
                            "items": {
                              "type": "string",
                              "pattern": "^[A-Z][1-9][0-9]*$"
                            },
                            "uniqueItems": true,
                            "minItems": 1
                          }
                        },
                        "additionalProperties": false
                      }
                    ]
                  }
                },
                "additionalProperties": false
              },
              {
                "type": "object",
                "required": [
                  "id",
                  "kind",
                  "k",
                  "region"
                ],
                "properties": {
                  "id": {
                    "type": "string",
                    "minLength": 1
                  },
                  "kind": {
                    "const": "AT_MOST"
                  },
                  "k": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "region": {
                    "oneOf": [
                      {
                        "type": "object",
                        "required": [
                          "type",
                          "index"
                        ],
                        "properties": {
                          "type": {
                            "const": "row"
                          },
                          "index": {
                            "type": "integer",
                            "minimum": 1
                          }
                        },
                        "additionalProperties": false
                      },
                      {
                        "type": "object",
                        "required": [
                          "type",
                          "index"
                        ],
                        "properties": {
                          "type": {
                            "const": "column"
                          },
                          "index": {
                            "type": "string",
                            "pattern": "^[A-Z]$"
                          }
                        },
                        "additionalProperties": false
                      },
                      {
                        "type": "object",
                        "required": [
                          "type",
                          "cell"
                        ],
                        "properties": {
                          "type": {
                            "const": "neighbors"
                          },
                          "cell": {
                            "type": "string",
                            "pattern": "^[A-Z][1-9][0-9]*$"
                          }
                        },
                        "additionalProperties": false
                      },
                      {
                        "type": "object",
                        "required": [
                          "type",
                          "cells"
                        ],
                        "properties": {
                          "type": {
                            "const": "cells"
                          },
                          "cells": {
                            "type": "array",
                            "items": {
                              "type": "string",
                              "pattern": "^[A-Z][1-9][0-9]*$"
                            },
                            "uniqueItems": true,
                            "minItems": 1
                          }
                        },
                        "additionalProperties": false
                      }
                    ]
                  }
                },
                "additionalProperties": false
              },
              {
                "type": "object",
                "required": [
                  "id",
                  "kind",
                  "parity",
                  "region"
                ],
                "properties": {
                  "id": {
                    "type": "string",
                    "minLength": 1
                  },
                  "kind": {
                    "const": "PARITY"
                  },
                  "parity": {
                    "enum": [
                      "ODD",
                      "EVEN"
                    ]
                  },
                  "region": {
                    "oneOf": [
                      {
                        "type": "object",
                        "required": [
                          "type",
                          "index"
                        ],
                        "properties": {
                          "type": {
                            "const": "row"
                          },
                          "index": {
                            "type": "integer",
                            "minimum": 1
                          }
                        },
                        "additionalProperties": false
                      },
                      {
                        "type": "object",
                        "required": [
                          "type",
                          "index"
                        ],
                        "properties": {
                          "type": {
                            "const": "column"
                          },
                          "index": {
                            "type": "string",
                            "pattern": "^[A-Z]$"
                          }
                        },
                        "additionalProperties": false
                      },
                      {
                        "type": "object",
                        "required": [
                          "type",
                          "cell"
                        ],
                        "properties": {
                          "type": {
                            "const": "neighbors"
                          },
                          "cell": {
                            "type": "string",
                            "pattern": "^[A-Z][1-9][0-9]*$"
                          }
                        },
                        "additionalProperties": false
                      },
                      {
                        "type": "object",
                        "required": [
                          "type",
                          "cells"
                        ],
                        "properties": {
                          "type": {
                            "const": "cells"
                          },
                          "cells": {
                            "type": "array",
                            "items": {
                              "type": "string",
                              "pattern": "^[A-Z][1-9][0-9]*$"
                            },
                            "uniqueItems": true,
                            "minItems": 1
                          }
                        },
                        "additionalProperties": false
                      }
                    ]
                  }
                },
                "additionalProperties": false
              },
              {
                "type": "object",
                "required": [
                  "id",
                  "kind",
                  "premises",
                  "conclusion"
                ],
                "properties": {
                  "id": {
                    "type": "string",
                    "minLength": 1
                  },
                  "kind": {
                    "const": "COMPOUND"
                  },
                  "premises": {
                    "type": "array",
                    "minItems": 1,
                    "maxItems": 8,
                    "items": {
                      "type": "object",
                      "required": [
                        "cell",
                        "status"
                      ],
                      "properties": {
                        "cell": {
                          "type": "string",
                          "pattern": "^[A-Z][1-9][0-9]*$"
                        },
                        "status": {
                          "enum": [
                            "CRIMINAL",
                            "INNOCENT"
                          ]
                        }
                      },
                      "additionalProperties": false
                    }
                  },
                  "conclusion": {
                    "type": "object",
                    "required": [
                      "cell",
                      "status"
                    ],
                    "properties": {
                      "cell": {
                        "type": "string",
                        "pattern": "^[A-Z][1-9][0-9]*$"
                      },
                      "status": {
                        "enum": [
                          "CRIMINAL",
                          "INNOCENT"
                        ]
                      }
                    },
                    "additionalProperties": false
                  }
                },
                "additionalProperties": false
              }
            ]
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
